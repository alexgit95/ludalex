# Copier en .env (non versionné) et renseigner les valeurs
POSTGRES_DB=ludalex
DB_USERNAME=ludalex
DB_PASSWORD=changer-moi

# Cloudflare Access : domaine d'équipe (xxx.cloudflareaccess.com) et audience (AUD) de l'application
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optionnel : options JVM (tas borné pour Raspberry Pi)
# JAVA_OPTS=-Xmx384m -XX:+UseSerialGC -Djava.awt.headless=true

# Optionnel : true pour que la récupération des copies d'images démarre active (par défaut : en pause, à activer depuis Admin > Images distantes)
# LUDALEX_IMAGES_COPIES_DEMARRAGE_ACTIF=false
