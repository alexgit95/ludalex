# Copier en .env (non versionné) et renseigner les valeurs
POSTGRES_DB=ludalex
DB_USERNAME=ludalex
DB_PASSWORD=changer-moi

# Cloudflare Access : domaine d'équipe (xxx.cloudflareaccess.com) et audience (AUD) de l'application
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

