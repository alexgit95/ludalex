@startuml
title LUDALEX - Modèle de données
hide circle
skinparam linetype ortho

' Aucune autre table pour l'instant. Les entités sont ajoutées par les changes suivants.
' La sauvegarde (0.9.0) n'ajoute aucune table : elle exporte joueur, jeu, pret, partie, participation et equipe
' (token_fin_partie est exclue et vidée à la restauration).

' Composant embarqué dans les entités qui portent une image (jeu, joueur)
class ImageSource <<Embeddable>> {
  type : VARCHAR(10)  ' UPLOAD | URL
  reference : VARCHAR(2048)  ' nom de fichier du volume, ou URL
}

class Joueur <<table joueur>> {
  id : BIGINT <<PK>>
  nom : VARCHAR(100)
  nom_normalise : VARCHAR(100)  ' minuscules, unicité parmi les joueurs actifs
  avatar_type / avatar_reference  ' ImageSource
  victoire_type / victoire_reference  ' ImageSource
  anonymise : BOOLEAN
}
Joueur *-- ImageSource : avatar
Joueur *-- ImageSource : image de victoire

class Jeu <<table jeu>> {
  id : BIGINT <<PK>>
  nom : VARCHAR(200)
  image_type / image_reference  ' ImageSource
  couleur_fond : VARCHAR(7)  ' #RRGGBB
  prix : DECIMAL(10,2) nullable
  date_achat : DATE nullable
  cooperatif : BOOLEAN
}
Jeu *-- ImageSource : image

class Pret <<table pret>> {
  id : BIGINT <<PK>>
  jeu_id : BIGINT <<FK>>
  emprunteur : VARCHAR(100)
  date_pret : DATE
  date_retour : DATE nullable  ' vide = prêt en cours
}
Jeu "1" <-- "0..*" Pret

class Partie <<table partie>> {
  id : BIGINT <<PK>>
  jeu_id : BIGINT <<FK>>
  date_partie : DATE
  lieu : VARCHAR(100) nullable
  statut : VARCHAR(12)  ' TERMINEE | EN_COURS | EN_PAUSE
  resultat_cooperatif : VARCHAR(10) nullable  ' VICTOIRE | DEFAITE
  joueur_suivant_id : BIGINT <<FK>> nullable  ' pause d'une partie en direct
  terminee_le : TIMESTAMP nullable  ' fin d'une partie en direct (vide si déclarée après coup)
}

class Participation <<table participation>> {
  id : BIGINT <<PK>>
  partie_id : BIGINT <<FK>>
  joueur_id : BIGINT <<FK>>
  score : INTEGER nullable
  gagnant : BOOLEAN
  equipe_id : BIGINT <<FK>> nullable
  ' unique (partie_id, joueur_id)
}

class Equipe <<table equipe>> {
  id : BIGINT <<PK>>
  partie_id : BIGINT <<FK>>
  nom : VARCHAR(100)
}

Jeu "1" <-- "0..*" Partie

class TokenFinPartie <<table token_fin_partie>> {
  id : BIGINT <<PK>>
  partie_id : BIGINT <<FK>>
  empreinte : VARCHAR(64)  ' SHA-256 du token, unique ; le token en clair n'est jamais stocké
  expire_le : TIMESTAMP
  utilise : BOOLEAN  ' usage unique
}
Partie "1" <-- "0..*" TokenFinPartie
Partie "1" *-- "1..*" Participation
Partie "1" *-- "0..*" Equipe
Joueur "1" <-- "0..*" Participation
Equipe "0..1" <-- "0..*" Participation
Joueur "0..1" <-- "0..*" Partie : joueur suivant
@enduml
